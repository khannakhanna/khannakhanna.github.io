---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDay, getWriting } from '../../lib/content';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getWriting();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <section class="page-head">
      <div class="container">
        <p class="eyebrow"><a href={href('/writing/')}>Writing</a></p>
        <h1>{post.data.title}</h1>
        <p class="muted meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDay(post.data.pubDate)}</time>
          {post.data.updatedDate && ` · updated ${formatDay(post.data.updatedDate)}`}
          {post.data.draft && <span class="badge draft">Draft</span>}
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container prose">
        <Content />
      </div>
    </section>
  </article>
</Base>

<style>
  .meta {
    margin: 0;
    font-size: 0.95rem;
  }

  .meta .badge {
    margin-left: 0.5rem;
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
</style>
