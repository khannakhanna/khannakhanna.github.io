---
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';
import { profile } from '../data/profile';
import { getCaseStudies } from '../lib/content';
import { href } from '../lib/url';

const featured = (await getCaseStudies()).slice(0, 3);
---

<Base>
  <section class="section hero">
    <div class="container hero-inner">
      <div>
        <p class="eyebrow">{profile.role}, {profile.employer} · {profile.location}</p>
        <h1>{profile.headline}</h1>
        <p class="lede">{profile.lede}</p>
        <div class="actions">
          <a class="button" href={href('/about/')}>About me</a>
          <a class="button secondary" href={href('/contact/')}>Get in touch</a>
        </div>
      </div>
      {
        profile.headshot ? (
          <img
            class="portrait"
            src={href(profile.headshot)}
            alt={`Portrait of ${profile.name}`}
            width="320"
            height="320"
          />
        ) : (
          <div class="portrait monogram" aria-hidden="true">
            {profile.initials}
          </div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="grid">
        {
          profile.facts.map((fact) => (
            <li class="card">
              <p class="fact-value">{fact.value}</p>
              <p>{fact.label}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">What I work on</p>
      <h2>Payments products, from platform to client</h2>
      <ul class="grid focus">
        {
          profile.focus.map((area) => (
            <li class="card">
              <h3>{area.title}</h3>
              <p>{area.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section">
        <div class="container">
          <p class="eyebrow">Selected work</p>
          <h2>Case studies</h2>
          <ul class="grid">
            {featured.map((study) => (
              <li class="card">
                <h3>
                  <a class="card-link" href={href(`/work/${study.id}/`)}>
                    {study.data.title}
                  </a>
                </h3>
                <p>{study.data.summary}</p>
                {study.data.draft && <span class="badge draft">Draft</span>}
              </li>
            ))}
          </ul>
          <p class="more">
            <a href={href('/work/')}>All case studies</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <ContactCta />
    </div>
  </section>
</Base>

<style>
  .hero-inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .portrait {
    width: min(100%, 16rem);
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
    justify-self: start;
  }

  .monogram {
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 4.5rem;
    width: 9rem;
  }

  .focus {
    margin-top: 1.5rem;
  }

  .more {
    margin: 1.5rem 0 0;
  }

  @media (min-width: 52rem) {
    .hero-inner {
      grid-template-columns: 1fr auto;
      gap: 4rem;
    }

    .portrait {
      justify-self: end;
    }

    .monogram {
      width: 14rem;
      font-size: 6.5rem;
    }
  }
</style>
